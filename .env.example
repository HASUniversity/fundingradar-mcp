# FundingRadar MCP — environment template.
#
# Copy to `.env`, paste a token, and never commit the result.
# MCP clients can also pass these variables in their own `env` block instead
# of using a `.env` file; see docs/CONFIGURATION.md.

# The application root, NOT the API directory. Defaults to the production
# installation when unset, so a colleague only has to set the token.
FUNDINGRADAR_API_URL=https://dilab.has.nl/showcases/fundingradar

# Personal API token: FundingRadar → Settings → API access → Create token.
# It is shown once. A token is read-only, belongs to the account that created it,
# and can be revoked there at any time.
FUNDINGRADAR_API_TOKEN=

# Optional: seconds before a request is given up on (1-300, default 30).
#FUNDINGRADAR_API_TIMEOUT=30
